{
	# Ensure PM2 restarts do not leave an old proxy holding ports 80/443.
	grace_period 10s
}

inguardy.com {
	handle /journal_screenshots/* {
		root * /opt/tradivix/app/public
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:3002
	}
}

www.inguardy.com {
	redir https://inguardy.com{uri} permanent
}
