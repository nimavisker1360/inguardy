  account     TradingAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assessment  InsuranceAssessment  @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  package     InsurancePackage     @relation(fields: [packageId], references: [id], onDelete: Restrict)
  policy      InsurancePolicy      @relation(fields: [policyId], references: [id], onDelete: Restrict)
  claim       InsuranceClaim?

  @@index([userId, createdAt])
  @@index([accountId, status, endsAt])
  @@index([status, endsAt])
}

model InsuranceClaim {
  id                     String               @id @default(cuid())
  claimNumber            String               @unique
  idempotencyKey         String               @unique
  coverageId             String               @unique
  userId                 String
  accountId              String
  status                 InsuranceClaimStatus @default(QUEUED)
  requestedAt            DateTime             @default(now())
  queuedAt               DateTime             @default(now())
  processingAt           DateTime?
  paidAt                 DateTime?
  rejectedAt             DateTime?
  cancelledAt            DateTime?
  balanceAtRequest       Decimal              @db.Decimal(18, 2)
  actualLoss             Decimal              @db.Decimal(18, 2)
  payoutAmount           Decimal              @db.Decimal(18, 2)
  openPositionsAtRequest Int                  @default(0)
  brokerAcknowledgedAt   DateTime?
  externalReference      String?
  decisionReason         String?
  cancellationReason     String?
  reviewerId             String?
  brokerPayload          Json
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  coverage InsuranceCoverage @relation(fields: [coverageId], references: [id], onDelete: Restrict)
  user     User              @relation("InsuranceClaimOwner", fields: [userId], references: [id], onDelete: Cascade)
  account  TradingAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  reviewer User?             @relation("InsuranceClaimReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, queuedAt])
  @@index([userId, requestedAt])
  @@index([accountId, requestedAt])
}

model InsuranceLoyaltyProfile {
  id                     String   @id @default(cuid())
  userId                 String
  accountId              String   @unique
  successfulCycles       Int      @default(0)
  premiumDiscountPercent Int      @default(0)
  riskScoreReduction     Int      @default(0)
  lastCoverageId         String?
  updatedAt              DateTime @updatedAt
  createdAt              DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account TradingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model InsuranceDecisionLog {
  id            String   @id @default(cuid())
  applicationId String
  actorId       String?
  decision      String
  reason        String
  metadata      Json?
  createdAt     DateTime @default(now())

  application InsuranceApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?                @relation("InsuranceDecisionActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([actorId])
}
