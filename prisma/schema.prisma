generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TradeDirection {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum TradeReviewStatus {
  DRAFT
  NEEDS_REVIEW
  REVIEWED
}

enum DailyJournalStatus {
  DRAFT
  COMPLETED
}

enum TradeUpdateType {
  SL_CHANGED
  TP_CHANGED
}

enum WebsiteSignalDirection {
  BUY
  SELL
}

enum WebsiteSignalStatus {
  OPEN
  CLOSED
}

enum WebsiteSignalCloseReason {
  TP
  SL
}

enum UserRole {
  USER
  ADMIN
}

enum PaymentStatus {
  PENDING
  WAITING_TXID
  UNDER_REVIEW
  CONFIRMED
  REJECTED
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
  TRIAL
  FREE
  MANUAL
}

enum PaymentNetwork {
  TRC20
  ERC20
  BEP20
}

enum TradingAccountIngestionMode {
  MANUAL
  EA_LEGACY
  DIRECT_MT5
  DIRECT_CTRADER
  DIRECT_TRADELOCKER
}

enum Mt5DirectConnectionStatus {
  PENDING
  CONNECTING
  INITIAL_SYNC
  ACTIVE
  ERROR
  DISCONNECTED
}

enum CtraderDirectConnectionStatus {
  PENDING
  CONNECTING
  INITIAL_SYNC
  ACTIVE
  ERROR
  DISCONNECTED
}

enum TradeLockerConnectionStatus {
  CONNECTED
  SYNCING
  ERROR
  REAUTH_REQUIRED
  DISCONNECTED
}

enum InsuranceEligibility {
  ELIGIBLE
  MANUAL_REVIEW
  NOT_ELIGIBLE
  INSUFFICIENT_DATA
  PENDING_ANALYSIS
}

enum InsuranceDataQuality {
  HIGH
  MEDIUM
  LOW
  INSUFFICIENT
}

enum InsuranceRiskLevel {
  LOW
  MODERATE
  HIGH
  VERY_HIGH
}

enum InsuranceFlagSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum InsuranceApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InsuranceCoverageStatus {
  ACTIVE
  CLAIM_QUEUED
  CLAIM_PROCESSING
  CLAIM_PAID
  EXPIRED
  VOID
  CANCELLED
}

enum InsuranceClaimStatus {
  QUEUED
  PROCESSING
  PAID
  REJECTED
  CANCELLED
}

enum CashTransactionType {
  DEPOSIT
  WITHDRAWAL
  BONUS
  TRANSFER
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole @default(USER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions                      Session[]
  accounts                      Account[]
  tradingAccounts               TradingAccount[]
  trades                        Trade[]
  tradeAIReviews                TradeAIReview[]
  journalConnections            JournalConnection[]
  tradeJournalMetadata          TradeJournalMetadata[]
  tradeScreenshots              TradeScreenshot[]
  voiceMemos                    VoiceMemo[]
  dailyJournals                 DailyJournal[]
  preTradeChecks                PreTradeCheck[]
  playbooks                     Playbook[]
  propFirmChallenges            PropFirmChallenge[]
  tags                          Tag[]
  playbookStrategies            PlaybookStrategy[]
  subscriptions                 Subscription[]
  payments                      Payment[]
  adminNotes                    AdminNote[]                @relation("UserAdminNotes")
  authoredAdminNotes            AdminNote[]                @relation("AdminAuthoredNotes")
  marketRadarUsages             MarketRadarAnalysisUsage[]
  mt5DirectConnections          Mt5DirectConnection[]
  ctraderOAuthGrant             CtraderOAuthGrant?
  ctraderDirectConnections      CtraderDirectConnection[]
  tradeLockerConnections        TradeLockerConnection[]
  tradeLockerAuthSessions       TradeLockerAuthSession[]
  insuranceAssessments          InsuranceAssessment[]
  insuranceApplications         InsuranceApplication[]     @relation("InsuranceApplicant")
  reviewedInsuranceApplications InsuranceApplication[]     @relation("InsuranceReviewer")
  insuranceDecisionLogs         InsuranceDecisionLog[]     @relation("InsuranceDecisionActor")
  insuranceCoverages            InsuranceCoverage[]        @relation("InsuranceCoverageOwner")
  insuranceClaims               InsuranceClaim[]           @relation("InsuranceClaimOwner")
  reviewedInsuranceClaims       InsuranceClaim[]           @relation("InsuranceClaimReviewer")
  insuranceLoyaltyProfiles      InsuranceLoyaltyProfile[]
  backtestSessions              BacktestSession[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Plan {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String?
  priceUSDT         Decimal  @db.Decimal(18, 2)
  durationDays      Int
  maxTrades         Int?
  maxScreenshots    Int?
  maxPlaybooks      Int?
  maxChecklists     Int?
  aiAnalysis        Boolean  @default(false)
  advancedAnalytics Boolean  @default(false)
  exportEnabled     Boolean  @default(false)
  isTrial           Boolean  @default(false)
  isFree            Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  payments      Payment[]
  subscriptions Subscription[]

  @@index([isActive])
  @@index([priceUSDT])
}

model Payment {
  id              String         @id @default(cuid())
  userId          String
  planId          String
  amount          Decimal        @db.Decimal(18, 2)
  currency        String         @default("USDT")
  network         PaymentNetwork @default(TRC20)
  walletAddress   String
  txid            String?        @unique
  status          PaymentStatus  @default(WAITING_TXID)
  adminNote       String?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  submittedAt     DateTime?
  confirmedAt     DateTime?
  rejectedAt      DateTime?
  expiresAt       DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         Plan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscription Subscription?

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([createdAt])
}

model Subscription {
  id         String             @id @default(cuid())
  userId     String
  planId     String
  paymentId  String?            @unique
  status     SubscriptionStatus
  startedAt  DateTime
  expiresAt  DateTime
  canceledAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan    Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([expiresAt])
}

model MarketRadarAnalysisUsage {
  id        String   @id @default(cuid())
  userId    String   @unique
  usedAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([usedAt])
}

model AdminNote {
  id        String   @id @default(cuid())
  userId    String
  adminId   String?
  note      String
  createdAt DateTime @default(now())

  user  User  @relation("UserAdminNotes", fields: [userId], references: [id], onDelete: Cascade)
  admin User? @relation("AdminAuthoredNotes", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([adminId])
}

model JournalConnection {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  tokenPreview String
  name         String?
  isActive     Boolean   @default(true)
  connectedAt  DateTime  @default(now())
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@index([connectedAt])
}

model TradingAccount {
  id                     String                      @id @default(cuid())
  userId                 String
  name                   String
  broker                 String?
  platform               String?
  currency               String                      @default("USD")
  balance                Decimal?                    @db.Decimal(18, 2)
  accountType            String?
  journalEnabled         Boolean                     @default(true)
  journalSecretHash      String?                     @unique
  journalSecretEncrypted String?
  mt5AccountNumber       String?
  ctraderAccountId       String?
  tradeLockerAccountId   String?
  lastConnectedAt        DateTime?
  lastSyncAt             DateTime?
  ingestionMode          TradingAccountIngestionMode @default(MANUAL)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  user                  User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades                Trade[]
  directConnection      Mt5DirectConnection?
  mt5BrokerDeals        Mt5BrokerDeal[]
  ctraderConnection     CtraderDirectConnection?
  ctraderBrokerDeals    CtraderBrokerDeal[]
  tradeLockerConnection TradeLockerConnection?
  tradeLockerOrders     TradeLockerOrder[]
  tradeLockerExecutions TradeLockerExecution[]
  tradeLockerPositions  TradeLockerPosition[]
  tradeLockerSnapshots  TradeLockerAccountSnapshot[]
  equitySnapshots       AccountEquitySnapshot[]
  symbolSpecifications  SymbolSpecification[]
  cashTransactions      CashTransaction[]
  insuranceMetrics      InsuranceMetrics[]
  insuranceAssessments  InsuranceAssessment[]
  insuranceRiskFlags    InsuranceRiskFlag[]
  insuranceApplications InsuranceApplication[]
  insuranceCoverages    InsuranceCoverage[]
  insuranceClaims       InsuranceClaim[]
  insuranceLoyalty      InsuranceLoyaltyProfile?
  backtestSessions      BacktestSession[]

  @@index([userId])
  @@index([mt5AccountNumber])
  @@index([ctraderAccountId])
  @@index([tradeLockerAccountId])
  @@index([ingestionMode])
}

model TradeLockerAuthSession {
  id                    String    @id @default(cuid())
  userId                String
  environment           String
  server                String
  email                 String
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime?
  expiresAt             DateTime
  createdAt             DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model TradeLockerConnection {
  id                     String                      @id @default(cuid())
  userId                 String
  accountId              String                      @unique
  environment            String
  server                 String
  email                  String
  tradeLockerAccountId   String
  accNum                 String
  accountName            String?
  accountStatus          String?
  accessTokenEncrypted   String?
  refreshTokenEncrypted  String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  tokenVersion           Int                         @default(0)
  tokenRefreshOwner      String?
  tokenRefreshUntil      DateTime?
  status                 TradeLockerConnectionStatus @default(SYNCING)
  enabled                Boolean                     @default(true)
  historyStartAt         DateTime
  cursorAt               DateTime?
  lastAttemptAt          DateTime?
  lastConnectedAt        DateTime?
  lastSyncAt             DateTime?
  lastError              String?
  importedOrderCount     Int                         @default(0)
  importedExecutionCount Int                         @default(0)
  leaseOwner             String?
  leaseUntil             DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  user        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     TradingAccount               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orders      TradeLockerOrder[]
  executions  TradeLockerExecution[]
  positions   TradeLockerPosition[]
  instruments TradeLockerInstrument[]
  snapshots   TradeLockerAccountSnapshot[]

  @@unique([userId, environment, server, tradeLockerAccountId])
  @@index([enabled, status])
  @@index([leaseUntil])
  @@index([lastSyncAt])
  @@index([tokenRefreshUntil])
}

model TradeLockerOrder {
  id                   String    @id @default(cuid())
  connectionId         String
  accountId            String
  externalOrderId      String
  dataKind             String
  externalPositionId   String?
  tradableInstrumentId String?
  side                 String?
  orderType            String?
  status               String?
  quantity             Decimal?  @db.Decimal(24, 8)
  filledQuantity       Decimal?  @db.Decimal(24, 8)
  averagePrice         Decimal?  @db.Decimal(24, 10)
  createdAtProvider    DateTime?
  modifiedAtProvider   DateTime?
  rawPayload           Json
  createdAt            DateTime  @default(now())

  connection TradeLockerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  account    TradingAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalOrderId, dataKind])
  @@index([connectionId, externalPositionId])
  @@index([connectionId, modifiedAtProvider])
}

model TradeLockerExecution {
  id                   String    @id @default(cuid())
  connectionId         String
  accountId            String
  externalExecutionId  String
  externalOrderId      String?
  externalPositionId   String?
  tradableInstrumentId String?
  side                 String?
  quantity             Decimal?  @db.Decimal(24, 8)
  price                Decimal?  @db.Decimal(24, 10)
  executedAt           DateTime?
  rawPayload           Json
  createdAt            DateTime  @default(now())

  connection TradeLockerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  account    TradingAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalExecutionId])
  @@index([connectionId, externalPositionId])
  @@index([connectionId, executedAt])
}

model TradeLockerPosition {
  id                   String    @id @default(cuid())
  connectionId         String
  accountId            String
  externalPositionId   String
  tradableInstrumentId String?
  side                 String?
  quantity             Decimal?  @db.Decimal(24, 8)
  averagePrice         Decimal?  @db.Decimal(24, 10)
  unrealizedPnl        Decimal?  @db.Decimal(18, 2)
  openedAt             DateTime?
  isOpen               Boolean   @default(true)
  rawPayload           Json
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  connection TradeLockerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  account    TradingAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalPositionId])
  @@index([accountId, isOpen])
}

model TradeLockerInstrument {
  id                   String   @id @default(cuid())
  connectionId         String
  tradableInstrumentId String
  instrumentId         String
  name                 String
  type                 String?
  rawPayload           Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  connection TradeLockerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, tradableInstrumentId])
  @@index([connectionId, name])
}

model TradeLockerAccountSnapshot {
  id           String   @id @default(cuid())
  connectionId String
  accountId    String
  capturedAt   DateTime
  balance      Decimal? @db.Decimal(18, 2)
  equity       Decimal? @db.Decimal(18, 2)
  floatingPnl  Decimal? @db.Decimal(18, 2)
  margin       Decimal? @db.Decimal(18, 2)
  freeMargin   Decimal? @db.Decimal(18, 2)
  rawPayload   Json
  createdAt    DateTime @default(now())

  connection TradeLockerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  account    TradingAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([connectionId, capturedAt])
  @@index([accountId, capturedAt])
}

model CtraderOAuthGrant {
  id                    String   @id @default(cuid())
  userId                String   @unique
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  accessTokenExpiresAt  DateTime
  permissionScope       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  connections CtraderDirectConnection[]

  @@index([accessTokenExpiresAt])
}

model CtraderDirectConnection {
  id                  String                        @id @default(cuid())
  userId              String
  accountId           String                        @unique
  grantId             String
  ctidTraderAccountId String
  traderLogin         String?
  environment         String
  brokerName          String?
  status              CtraderDirectConnectionStatus @default(PENDING)
  enabled             Boolean                       @default(true)
  historyStartAt      DateTime
  cursorAt            DateTime?
  lastAttemptAt       DateTime?
  lastConnectedAt     DateTime?
  lastSyncAt          DateTime?
  lastError           String?
  importedDealCount   Int                           @default(0)
  leaseOwner          String?
  leaseUntil          DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  account TradingAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  grant   CtraderOAuthGrant   @relation(fields: [grantId], references: [id], onDelete: Cascade)
  deals   CtraderBrokerDeal[]

  @@unique([userId, ctidTraderAccountId])
  @@index([grantId])
  @@index([enabled, status])
  @@index([leaseUntil])
  @@index([lastSyncAt])
}

model CtraderBrokerDeal {
  id                 String   @id @default(cuid())
  connectionId       String
  accountId          String
  externalDealId     String
  externalOrderId    String?
  externalPositionId String
  symbolId           String
  symbol             String
  tradeSide          Int
  isClosing          Boolean  @default(false)
  volume             Decimal  @db.Decimal(18, 4)
  price              Decimal  @db.Decimal(18, 8)
  commission         Decimal  @default(0) @db.Decimal(18, 2)
  swap               Decimal  @default(0) @db.Decimal(18, 2)
  profit             Decimal  @default(0) @db.Decimal(18, 2)
  fee                Decimal  @default(0) @db.Decimal(18, 2)
  executedAt         DateTime
  rawPayload         Json?
  createdAt          DateTime @default(now())

  connection CtraderDirectConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  account    TradingAccount          @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalDealId])
  @@index([accountId, externalPositionId])
  @@index([connectionId, executedAt])
  @@index([externalOrderId])
}

model Mt5DirectConnection {
  id                  String                    @id @default(cuid())
  userId              String
  accountId           String                    @unique
  server              String
  login               String
  credentialEncrypted String?
  status              Mt5DirectConnectionStatus @default(PENDING)
  enabled             Boolean                   @default(true)
  historyStartAt      DateTime
  cursorAt            DateTime?
  lastAttemptAt       DateTime?
  lastConnectedAt     DateTime?
  lastSyncAt          DateTime?
  lastError           String?
  importedDealCount   Int                       @default(0)
  leaseOwner          String?
  leaseUntil          DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account TradingAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deals   Mt5BrokerDeal[]

  @@unique([userId, server, login])
  @@index([enabled, status])
  @@index([leaseUntil])
  @@index([lastSyncAt])
}

model Mt5BrokerDeal {
  id                 String   @id @default(cuid())
  connectionId       String
  accountId          String
  externalDealId     String
  externalOrderId    String?
  externalPositionId String
  symbol             String
  dealType           Int
  entryType          Int
  reason             Int?
  magic              String?
  volume             Decimal  @db.Decimal(18, 4)
  price              Decimal  @db.Decimal(18, 8)
  commission         Decimal  @default(0) @db.Decimal(18, 2)
  swap               Decimal  @default(0) @db.Decimal(18, 2)
  fee                Decimal  @default(0) @db.Decimal(18, 2)
  profit             Decimal  @default(0) @db.Decimal(18, 2)
  executedAt         DateTime
  executedAtMsc      BigInt?
  rawPayload         Json?
  createdAt          DateTime @default(now())

  connection Mt5DirectConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  account    TradingAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalDealId])
  @@index([accountId, externalPositionId])
  @@index([connectionId, executedAt])
  @@index([externalOrderId])
}

model Trade {
  id        String         @id @default(cuid())
  userId    String
  accountId String
  symbol    String
  direction TradeDirection
  status    TradeStatus    @default(OPEN)

  entryPrice        Decimal? @db.Decimal(18, 5)
  exitPrice         Decimal? @db.Decimal(18, 5)
  stopLoss          Decimal? @db.Decimal(18, 5)
  takeProfit        Decimal? @db.Decimal(18, 5)
  initialStopLoss   Decimal? @db.Decimal(18, 5)
  initialTakeProfit Decimal? @db.Decimal(18, 5)
  currentStopLoss   Decimal? @db.Decimal(18, 5)
  currentTakeProfit Decimal? @db.Decimal(18, 5)
  lotSize           Decimal? @db.Decimal(18, 2)
  riskAmount        Decimal? @db.Decimal(18, 2)
  profitLoss        Decimal? @db.Decimal(18, 2)
  commission        Decimal? @db.Decimal(18, 2)
  swap              Decimal? @db.Decimal(18, 2)
  rr                Decimal? @db.Decimal(10, 2)
  grossProfit       Decimal? @db.Decimal(18, 2)
  balanceAtOpen     Decimal? @db.Decimal(18, 2)
  equityAtOpen      Decimal? @db.Decimal(18, 2)
  balanceAtClose    Decimal? @db.Decimal(18, 2)
  equityAtClose     Decimal? @db.Decimal(18, 2)
  magicNumber       String?
  closeReason       String?

  setup   String?
  session String?
  emotion String?
  mistake String?
  notes   String?

  source                String            @default("MANUAL")
  mt5Ticket             String?
  tradeLockerPositionId String?
  aiReviewStatus        String            @default("NOT_REVIEWED")
  aiReviewScore         Int?
  reviewStatus          TradeReviewStatus @default(DRAFT)
  reviewedAt            DateTime?

  playbookId                  String?
  checklistCompletedAt        DateTime?
  psychologyReviewCompletedAt DateTime?
  strategyReviewCompletedAt   DateTime?

  openedAt  DateTime?
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account            TradingAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  screenshots        TradeScreenshot[]
  voiceMemos         VoiceMemo[]
  tags               TradeTag[]
  checklists         TradeChecklist[]
  strategyReview     TradeStrategyReview?
  aiReviews          TradeAIReview[]
  journalMetadata    TradeJournalMetadata?
  updateLogs         TradeUpdateLog[]
  insuranceRiskFlags InsuranceRiskFlag[]

  @@unique([accountId, mt5Ticket])
  @@unique([accountId, tradeLockerPositionId])
  @@index([userId])
  @@index([accountId])
  @@index([symbol])
  @@index([source])
  @@index([aiReviewStatus])
  @@index([reviewStatus])
  @@index([playbookId])
  @@index([mt5Ticket])
  @@index([openedAt])
  @@index([closedAt])
  @@index([userId, createdAt])
  @@index([userId, status])
}

model BacktestSession {
  id                String    @id @default(cuid())
  userId            String
  accountId         String?
  playbookId        String?
  symbol            String
  timeframe         String
  endDate           DateTime
  historySize       Int
  speed             Int       @default(700)
  status            String    @default("ACTIVE")
  currentCandleTime DateTime?
  activePosition    Json?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  TradingAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  playbook PlaybookStrategy? @relation(fields: [playbookId], references: [id], onDelete: SetNull)
  trades   BacktestTrade[]

  @@index([userId, status, updatedAt])
  @@index([accountId])
  @@index([playbookId])
}

model BacktestTrade {
  id                 String    @id @default(cuid())
  sessionId          String
  clientPositionId   String
  direction          String
  status             String
  entry              Decimal   @db.Decimal(24, 8)
  stopLoss           Decimal   @db.Decimal(24, 8)
